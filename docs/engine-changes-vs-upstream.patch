+
+// Vrai quand la fenetre de texte est la boite ADV de l'histoire (image textbox\...) :
+// le texte est alors affiche par l'interface Android, pas par le moteur.
+bool PonscripterLabel::nativeStoryText()
+{
+    static int last = -1;
+    const char* n = sentence_font_info.image_name;
+    bool story = g_native_text_wanted && g_story_active && n && strstr(n, "textbox") != NULL;
+    if ((int) story != last) {
+        last = story;
+        android_send_mode(story ? 1 : 0);
+    }
+    // Boutons (choix, menu clic droit...) : le moteur dessine tout, sans rognage
+    // (attente de clic de l'histoire : event_mode contient aussi WAIT_TEXTBTN_MODE ;
+    //  menu ouvert : WAIT_BUTTON_MODE seul)
+    bool menuOrChoice = ((event_mode & WAIT_BUTTON_MODE) && !(event_mode & WAIT_TEXTBTN_MODE))
+                        || !select_links.empty();
+    return story && !menuOrChoice;
+}
+
+extern "C" void android_send_buttons(const char* data);
+
+// Menu de l'histoire (clic droit...) : boutons de sprites a libelle connu, affiches par Android
+static bool g_menu_redraw = false; // le menu natif vient (re)devenir actif : redessiner sans les plaques
+
+bool PonscripterLabel::nativeMenuActive()
+{
+    static bool prev = false;
+    bool act = g_native_text_wanted && g_story_active
+        && ((event_mode & WAIT_BUTTON_MODE) && !(event_mode & WAIT_TEXTBTN_MODE))
+        && select_links.empty() && !buttons.empty();
+    if (act && !prev) g_menu_redraw = true;
+    prev = act;
+    return act;
+}
+
+bool PonscripterLabel::isMenuButtonAnim(AnimationInfo* a)
+{
+    for (ButtonElt::iterator it = buttons.begin(); it != buttons.end(); ++it)
+        if (it->second.isSprite() && it->second.sprite_no >= 0 && a == &sprite_info[it->second.sprite_no])
+            return true;
+    return false;
+}
+
+void PonscripterLabel::androidPublishButtons()
+{
+    static std::string last;
+    std::string out;
+    if (nativeMenuActive()) {
+        for (ButtonElt::iterator it = buttons.begin(); it != buttons.end(); ++it) {
+            if (!it->second.isSprite() || it->second.sprite_no < 0) continue;
+            AnimationInfo* a = &sprite_info[it->second.sprite_no];
+            const char* n = a->image_name;
+            const char* f = a->file_name;
+            if (!n && !f) continue;
+            char head[32];
+            snprintf(head, sizeof(head), "%d%c", it->first, 9);
+            out += head;
+            out += n ? n : "";
+            out += (char) 9;
+            out += f ? f : "";
+            out += (char) 10;
+        }
+    }
+    bool redraw = g_menu_redraw;
+    g_menu_redraw = false;
+    if (out != last) {
+        redraw = redraw || !last.empty() || !out.empty();
+        last = out;
+        android_send_buttons(out.c_str());
+    }
+    if (redraw) {
+        // redessine la scene sans (ou avec) les plaques du menu deja incrustees
+        dirty_rect.fill(screen_width, screen_height);
+        flush(refreshMode());
+    }
+}
+
+void PonscripterLabel::androidPressButton(int id)
+{
+    if (!(event_mode & WAIT_BUTTON_MODE)) return;
+    if (id >= 0 && buttons.find(id) == buttons.end()) return;
+    current_button_state.button  = id;
+    volatile_button_state.button = id;
+    current_button_state.down_flag = false;
+    playClickVoice();
+    stopAnimation(clickstr_state);
+    advancePhase();
+}
+#else
+bool PonscripterLabel::nativeStoryText() { return false; }
+bool PonscripterLabel::nativeMenuActive() { return false; }
+bool PonscripterLabel::isMenuButtonAnim(AnimationInfo*) { return false; }
+void PonscripterLabel::androidPublishButtons() {}
+void PonscripterLabel::androidPressButton(int) {}
+#endif
