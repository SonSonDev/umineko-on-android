+#ifdef ANDROID_PORT
+int g_crop_x = 0; // decalage de la zone visible, en coordonnees du jeu (pour les clics)
+
+static int g_lw = -1, g_lh = -1;
+
+static void setLogicalOnce(SDL_Renderer* r, int w, int h)
+{
+    if (w != g_lw || h != g_lh) {
+        g_lw = w; g_lh = h;
+        SDL_RenderSetLogicalSize(r, w, h);
+    }
+}
+
+// Lecture video : plein cadre 16:9 complet (pas de rognage), le reste de la surface reste noir
+void androidSetFullLogical(SDL_Renderer* r, int w, int h)
+{
+    setLogicalOnce(r, w, h);
+}
+
+// Pendant l'histoire en portrait, ne montre qu'une bande centree de la scene (rognage lateral)
+// et la place pour que chaque personnage reste visible a au moins 2/3.
+bool PonscripterLabel::androidViewRect(SDL_Rect* out)
+{
+    static bool panValid = false;
+    static float panShown = 0;
+    static Uint32 panTime = 0;
+    g_crop_x = 0;
+    int ww = 0, wh = 0;
+    if (!nativeStoryText() || !screen) { panValid = false; setLogicalOnce(renderer, screen_width, screen_height); return false; }
+    SDL_GetWindowSize(screen, &ww, &wh);
+    if (ww <= 0 || wh <= 0) { setLogicalOnce(renderer, screen_width, screen_height); return false; }
+    int cw = (int) (screen_height * (float) ww / (float) wh + 0.5f);
+    if (cw >= screen_width) { setLogicalOnce(renderer, screen_width, screen_height); return false; }
+
+    int n = 0, sx0[3], sx1[3];
+    for (int i = 0; i < 3; ++i) {
+        if (!tachi_info[i].image_surface) continue;
+        int x0 = tachi_info[i].pos.x, x1 = x0 + tachi_info[i].pos.w;
+        if (x1 <= 0 || x0 >= screen_width || x1 <= x0) continue;
+        sx0[n] = x0; sx1[n] = x1; ++n;
+    }
+    int maxpan = screen_width - cw;
+    int pan = maxpan / 2;
+    if (n > 0) {
+        int u0 = sx0[0], u1 = sx1[0];
+        for (int i = 1; i < n; ++i) { if (sx0[i] < u0) u0 = sx0[i]; if (sx1[i] > u1) u1 = sx1[i]; }
+        int desired = (u0 + u1) / 2 - cw / 2;
+        if (desired < 0) desired = 0;
+        if (desired > maxpan) desired = maxpan;
+        float bestScore = -1; int bestDist = 1 << 30; pan = desired;
+        for (int p = 0; p <= maxpan; p += 2) {
+            float worst = 1.0f;
+            for (int i = 0; i < n; ++i) {
+                int a = sx0[i] > p ? sx0[i] : p, b = sx1[i] < p + cw ? sx1[i] : p + cw;
+                float vis = b > a ? (float) (b - a) / (float) (sx1[i] - sx0[i]) : 0.0f;
+                if (vis < worst) worst = vis;
+            }
+            if (worst > 0.70f) worst = 1.0f; // au moins 2/3 (marge): tous les cas valides se valent
+            int dist = p > desired ? p - desired : desired - p;
+            if (worst > bestScore + 0.001f || (worst > bestScore - 0.001f && dist < bestDist)) {
+                bestScore = worst; bestDist = dist; pan = p;
+            }
+        }
+    }
+    // Glissement : la zone visible rejoint sa cible en douceur (amortissement exponentiel, ~0,3 s)
+    Uint32 now = SDL_GetTicks();
+    if (!panValid) {
+        panShown = (float) pan;
+        panValid = true;
+    } else {
+        float dt = (float) (now - panTime);
+        if (dt > 100.0f) dt = 100.0f;
+        float k = 1.0f - expf(-dt / 90.0f);
+        panShown += ((float) pan - panShown) * k;
+        if (fabsf((float) pan - panShown) < 0.6f) panShown = (float) pan;
+    }
+    panTime = now;
+    if (panShown < 0) panShown = 0;
+    if (panShown > (float) maxpan) panShown = (float) maxpan;
+    pan = (int) (panShown + 0.5f);
+    g_crop_x = pan;
+    out->x = pan; out->y = 0; out->w = cw; out->h = screen_height;
+    setLogicalOnce(renderer, cw, screen_height);
+    return true;
+}
+#endif
